pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'pip install -r requirements.txt'
            }
        }
        stage('Test') {
            steps {
                sh 'python -m pytest tests/ -v'
            }
        }
        stage('Package') {
            steps {
                sh 'pyinstaller --onefile src/main.py'
                archiveArtifacts artifacts: 'dist/main*', fingerprint: true
            }
        }
    }
}
